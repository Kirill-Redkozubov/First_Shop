# ====================================================================
# ФАЙЛЫ ОКРУЖЕНИЯ И СЕКРЕТЫ (КРИТИЧЕСКИ ВАЖНО!)
# ====================================================================
# Никогда не коммитьте файлы с паролями, токенами и ключами
.env
.env.local
.env.*.local
*.env
*.pem
*.key
certs/


# ====================================================================
# БЭКЕНД: FastAPI / Python
# ====================================================================
# Виртуальные окружения
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# Кэш Python и байт-код
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Базы данных (локальные для тестов)
*.db
*.sqlite3


# ====================================================================
# ФРОНТЕНД: React / Node.js
# ====================================================================
# Зависимости
node_modules/
/jspm_packages/

# Папки сборки (билды)
dist/
build/
.next/
out/

# Логи npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Кэш фронтенд-инструментов (Vite, Turbo, ESLint)
.vite/
.turbo/
.eslintcache


# ====================================================================
# СИСТЕМНЫЕ ФАЙЛЫ И НАСТРОЙКИ IDE
# ====================================================================
